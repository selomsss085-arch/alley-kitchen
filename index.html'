    {id:'d2',cat:'drink',h:28,e:'🧋',p:20000,
      n:{zh:'黑糖珍奶',en:'Brown Sugar Milk Tea',id:'Boba Gula Aren'},
      d:{zh:'珍珠现煮，只能做冰的',en:'Fresh pearls, iced only',id:'Boba baru, hanya dingin'}},
