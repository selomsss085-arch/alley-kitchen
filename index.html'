  }
  .search input::placeholder{color:#BCA797}
  .cats{display:flex;gap:8px;overflow-x:auto;padding:16px 2px 4px;scrollbar-width:none}
  .cats::-webkit-scrollbar{display:none}
  .chip{
    border:1px solid var(--line);background:#fff;color:var(--ink2);
    font-size:13px;padding:7px 15px;border-radius:999px;white-space:nowrap;font-family:inherit;
    transition:.18s;
  }
  .chip.on{background:var(--dark);border-color:var(--dark);color:#fff}
  .list{margin-top:10px;display:flex;flex-direction:column;gap:10px}
  .item{
    display:flex;gap:13px;align-items:center;
    background:var(--card);border:1px solid rgba(241,227,214,.9);
    border-radius:19px;padding:12px;
    box-shadow:0 6px 18px rgba(140,95,60,.06);
  }
  .thumb{
    width:64px;height:64px;border-radius:16px;flex:0 0 auto;
    display:grid;place-items:center;font-size:29px;
  }
  .info{flex:1;min-width:0}
  .name{font-size:15px;font-weight:600;line-height:1.3}
  .desc{font-size:12px;color:var(--ink2);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .price{font-size:14px;font-weight:700;color:var(--accent);margin-top:6px}
  .add{
    width:34px;height:34px;flex:0 0 auto;border:0;border-radius:12px;
    background:var(--accent);color:#fff;font-size:19px;line-height:1;
    display:grid;place-items:center;font-family:inherit;
  }
  .add:active{transform:scale(.92)}
  .stepper{
    display:flex;align-items:center;gap:6px;background:var(--soft);
    border-radius:12px;padding:3px;flex:0 0 auto;
  }
  .stepper button{
    width:27px;height:27px;border:0;border-radius:9px;background:#fff;
    color:var(--accent);font-size:15px;font-weight:700;font-family:inherit;
    display:grid;place-items:center;
  }
  .stepper span{min-width:15px;text-align:center;font-size:13.5px;font-weight:700}
  .empty{margin-top:26px;text-align:center;color:var(--ink2);font-size:13.5px}
  .foot{margin-top:20px;text-align:center;font-size:11.5px;color:#C0AC9C}
  .bar{
    position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));
    background:var(--dark);color:#fff;border-radius:20px;padding:11px 13px;
    display:flex;align-items:center;gap:11px;
    box-shadow:0 14px 34px rgba(40,20,10,.3);
    transform:translateY(150%);transition:transform .3s cubic-bezier(.2,.85,.2,1);z-index:30;
  }
  .bar.show{transform:none}
  .bar .cnt{
    background:rgba(255,255,255,.15);border-radius:12px;padding:7px 11px;font-size:12.5px;white-space:nowrap;
  }
  .bar .sum{flex:1;min-width:0;line-height:1.25}
  .bar .sum span{display:block;font-size:10.5px;color:rgba(255,255,255,.6);letter-spacing:.4px}
  .bar .sum b{font-size:16.5px}
  .bar .go{
    border:0;background:var(--accent);color:#fff;font-family:inherit;
    font-size:14px;font-weight:600;padding:11px 17px;border-radius:14px;white-space:nowrap;
  }
  .backdrop{
    position:fixed;inset:0;background:rgba(30,18,12,.42);z-index:40;
    opacity:0;pointer-events:none;transition:opacity .25s;
    -webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px);
  }
  .backdrop.show{opacity:1;pointer-events:auto}
  .sheet{
    position:fixed;left:0;right:0;bottom:0;z-index:41;
    background:var(--bg);border-radius:26px 26px 0 0;
    padding:10px 18px calc(22px + env(safe-area-inset-bottom));
    max-height:84vh;overflow:auto;
    transform:translateY(100%);transition:transform .32s cubic-bezier(.2,.85,.2,1);
    box-shadow:0 -10px 40px rgba(60,35,20,.18);
  }
  .sheet.show{transform:none}
  .grab{width:38px;height:4px;border-radius:9px;background:#E2D2C4;margin:0 auto 14px}
  .sheet h3{margin:0 0 14px;font-size:17px}
  .row{
    display:flex;align-items:center;gap:12px;padding:11px 0;
    border-bottom:1px solid var(--line);
  }
  .row:last-child{border-bottom:0}
  .row .rn{flex:1;min-width:0;font-size:14.5px;font-weight:500}
  .row .rp{font-size:12.5px;color:var(--ink2);margin-top:2px}
  .totrow{display:flex;align-items:baseline;justify-content:space-between;margin-top:16px}
  .totrow span{font-size:13px;color:var(--ink2)}
  .totrow b{font-size:22px;color:var(--accent)}
  .actions{display:flex;gap:10px;margin-top:16px}
  .btn{
    flex:1;border:0;border-radius:16px;font-family:inherit;font-size:15px;font-weight:600;
    padding:14px;text-align:center;
  }
  .btn.ghost{background:#fff;color:var(--ink2);border:1px solid var(--line)}
  .btn.main{background:var(--accent);color:#fff}
  .note{font-size:11.5px;color:#BFAB9B;text-align:center;margin-top:14px;line-height:1.5}
  .done{text-align:center;padding:14px 0 4px}
  .done .tick{
    width:58px;height:58px;margin:0 auto 12px;border-radius:50%;
    background:#E8F6EC;color:#3E9B5C;display:grid;place-items:center;font-size:28px;
  }
  .done h2{margin:0;font-size:19px}
  .done .no{margin-top:7px;font-size:12.5px;color:var(--ink2);letter-spacing:.5px}
  .toast{
    position:fixed;left:50%;bottom:104px;z-index:60;pointer-events:none;
    background:rgba(36,26,20,.93);color:#fff;font-size:13px;
    padding:9px 17px;border-radius:999px;max-width:80vw;text-align:center;
    opacity:0;transform:translate(-50%,16px);transition:.26s;
  }
  .toast.show{opacity:1;transform:translate(-50%,0)}
  @media (prefers-color-scheme: dark){
    :root{--bg:#1B1512;--card:#241C17;--ink:#F5EAE2;--ink2:#A08D7F;--line:#3A2C24;--soft:#3A2A20}
    body{background:
      radial-gradient(120% 55% at 105% -5%, #3B2418 0%, rgba(59,36,24,0) 62%),
      radial-gradient(80% 45% at -10% 8%, #2A1D16 0%, rgba(42,29,22,0) 60%),
      var(--bg)}
    .lang,.search,.chip,.item,.btn.ghost{background:var(--card)}
    .search input{color:var(--ink)}
    #badge{background:#1E3527;color:#7FC79A}
    .done .tick{background:#1E3527}
    .stepper button{background:#3A2A20;color:#FF9A6B}
    .grab{background:#4A392F}
  }
</style>
</head>
<body>

<header>
  <div class="hd-top">
    <div>
      <div id="shop">小巷食堂</div>
      <div id="tag">今天想吃点什么</div>
    </div>
    <div id="badge">营业中</div>
  </div>
  <div class="langs">
    <button class="lang" data-act="lang" data-lang="zh">中文</button>
    <button class="lang" data-act="lang" data-lang="en">English</button>
    <button class="lang" data-act="lang" data-lang="id">Bahasa</button>
  </div>
  <div class="search">
    <span>🔍</span>
    <input id="q" type="text" placeholder="搜菜名，或者凭心情">
