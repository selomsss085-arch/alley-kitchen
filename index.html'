      n:{zh:'鲜榨橙汁',en:'Fresh Orange Juice',id:'Jus Jeruk Segar'},
      d:{zh:'现榨，不加冰',en:'Squeezed to order, no ice',id:'Diperas saat dipesan'}},
    {id:'d4',cat:'drink',h:24,e:'☕',p:18000,
      n:{zh:'冰咖啡',en:'Iced Coffee',id:'Kopi Susu Dingin'},
      d:{zh:'本地豆，偏甜',en:'Local beans, on the sweet side',id:'Biji lokal, agak manis'}},
    {id:'t1',cat:'dessert',h:38,e:'🥭',p:26000,
      n:{zh:'芒果糯米饭',en:'Mango Sticky Rice',id:'Ketan Mangga'},
      d:{zh:'椰浆淋在热糯米上',en:'Coconut cream over warm rice',id:'Santan di atas ketan hangat'}},
    {id:'t2',cat:'dessert',h:180,e:'🥥',p:18000,
      n:{zh:'椰奶西米露',en:'Coconut Sago',id:'Sagu Kelapa'},
      d:{zh:'冷的，小小一碗',en:'Chilled, small bowl',id:'Dingin, mangkuk kecil'}}
  ];

var CATS = ['all','main','snack','drink','dessert'];

var T = {
    zh:{shop:'小巷食堂',tag:'今天想吃点什么',open:'营业中',search:'搜菜名，或者凭心情',
        all:'全部',main:'主食',snack:'小吃',drink:'饮料',dessert:'甜点',
        empty:'这个分类还是空的',cart:'购物车',emptyCart:'还没往篮子里放东西',
        total:'合计',checkout:'去结算',clear:'清空',unit:'件',
        added:'已加入',ordered:'下单成功',no:'订单号',again:'再来一单',
        note:'演示菜单 · 不会真的做出来，也不会真的送到'},
    en:{shop:'Alley Kitchen',tag:'What do you feel like today?',open:'Open',search:'Search a dish, or a mood',
        all:'All',main:'Mains',snack:'Snacks',drink:'Drinks',dessert:'Desserts',
        empty:'Nothing in this category yet',cart:'Your tray',emptyCart:'Your tray is empty',
        total:'Total',checkout:'Checkout',clear:'Clear',unit:'items',
        added:'Added',ordered:'Order placed',no:'Order',again:'Order again',
        note:'Demo menu · nothing will actually be cooked or delivered'},
    id:{shop:'Dapur Gang',tag:'Hari ini mau makan apa?',open:'Buka',search:'Cari menu, atau suasana hati',
        all:'Semua',main:'Utama',snack:'Camilan',drink:'Minuman',dessert:'Manis',
        empty:'Belum ada di kategori ini',cart:'Keranjang',emptyCart:'Keranjang masih kosong',
        total:'Total',checkout:'Bayar',clear:'Kosongkan',unit:'item',
        added:'Ditambahkan',ordered:'Pesanan diterima',no:'Nomor',again:'Pesan lagi',
        note:'Menu demo · tidak ada yang benar-benar dimasak atau diantar'}
  };

var KEY = 'alley.order.v1';
  var S = {lang:'zh', cat:'all', q:'', cart:{}, order:null};

function load(){
    try{
      var raw = localStorage.getItem(KEY);
      if(raw){
        var o = JSON.parse(raw);
        if(o && typeof o === 'object'){
          S.lang = o.lang || 'zh';
          S.cat = o.cat || 'all';
          S.q = o.q || '';
          S.cart = o.cart || {};
          S.order = null;
        }
      }
    }catch(e){}
  }
  function save(){
    try{ localStorage.setItem(KEY, JSON.stringify({lang:S.lang,cat:S.cat,q:S.q,cart:S.cart})); }catch(e){}
  }
  function L(){ return T[S.lang]; }
  function money(n){
    return 'Rp ' + String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g,'.');
  }
  function find(id){
    for(var i=0;i<MENU.length;i++){ if(MENU[i].id===id) return MENU[i]; }
    return null;
  }
  function qty(){ var s=0; for(var k in S.cart){ s += S.cart[k]||0; } return s; }
  function total(){
    var s=0; for(var k in S.cart){ var it=find(k); if(it) s += it.pS.cart[k]; }
    return s;
  }
  function $(sel){ return document.querySelector(sel); }

function setTexts(){
    var t = L();
    $('#shop').textContent = t.shop;
    $('#tag').textContent = t.tag;
    $('#badge').textContent = t.open;
    $('#q').placeholder = t.search;
    document.documentElement.lang = S.lang === 'zh' ? 'zh-Hans' : S.lang;
    var btns = document.querySelectorAll('.lang');
    for(var i=0;i<btns.length;i++){
      btns[i].className = 'lang' + (btns[i].getAttribute('data-lang')===S.lang ? ' on' : '');
    }
  }

function renderCats(){
    var t = L(), html = '';
    for(var i=0;i<CATS.length;i++){
      var c = CATS[i];
      html += '<button class="chip' + (S.cat===c?' on':'') + '" data-act="cat" data-id="' + c + '">' + t[c] + '</button>';
    }
    $('#cats').innerHTML = html;
  }

function visible(){
    var q = S.q.trim().toLowerCase(), out = [];
    for(var i=0;i<MENU.length;i++){
      var it = MENU[i];
      if(S.cat !== 'all' && it.cat !== S.cat) continue;
      if(q){
        var hay = (it.n[S.lang] + ' ' + it.d[S.lang]).toLowerCase();
        if(hay.indexOf(q) < 0) continue;
      }
      out.push(it);
    }
    return out;
  }

function renderList(){
    var t = L(), items = visible(), html = '';
    for(var i=0;i<items.length;i++){
      var it = items[i], q = S.cart[it.id] || 0;
      var act = q > 0
        ? '<div class="stepper"><button data-act="dec" data-id="' + it.id + '">−</button><span>' + q + '</span><button data-act="inc" data-id="' + it.id + '">+</button></div>'
        : '<button class="add" data-act="add" data-id="' + it.id + '">+</button>';
      html += '<article class="item">'
        + '<div class="thumb" style="background:linear-gradient(145deg,hsl(' + it.h + ',95%,93%),hsl(' + it.h + ',88%,84%))">' + it.e + '</div>'
        + '<div class="info">'
        +   '<div class="name">' + it.n[S.lang] + '</div>'
        +   '<div class="desc">' + it.d[S.lang] + '</div>'
        +   '<div class="price">' + money(it.p) + '</div>'
        + '</div>' + act + '</article>';
    }
    if(!items.length) html = '<div class="empty">' + t.empty + '</div>';
    html += '<div class="foot">' + t.note + '</div>';
    $('#list').innerHTML = html;
  }

function renderBar(){
    var t = L(), n = qty(), bar = $('#bar');
    if(!n){ bar.className = 'bar'; bar.innerHTML = ''; return; }
    bar.innerHTML = '<div class="cnt">' + n + ' ' + t.unit + '</div>'
      + '<div class="sum"><span>' + t.total + '</span><b>' + money(total()) + '</b></div>'
      + '<button class="go" data-act="cart">' + t.checkout + '</button>';
    bar.className = 'bar show';
  }

var sheetOpen = false;

function renderSheet(){
    var t = L(), s = $('#sheet');
    if(!sheetOpen){ s.className = 'sheet'; s.innerHTML = ''; $('#backdrop').className = 'backdrop'; return; }

var html = '<div class="grab"></div>';

if(S.order){
      html += '<div class="done"><div class="tick">✓</div><h2>' + t.ordered + '</h2>'
        + '<div class="no">' + t.no + ' · ' + S.order.no + '</div></div>';
      html += '<div style="margin-top:18px">';
      for(var i=0;i<S.order.items.length;i++){
        var oi = S.order.items[i], it = find(oi.id);
        if(!it) continue;
        html += '<div class="row"><div class="rn">' + it.n[S.lang]
          + '<div class="rp">' + oi.q + ' × ' + money(it.p) + '</div></div>'
          + '<div class="rn" style="flex:0 0 auto;font-weight:600">' + money(it.poi.q) + '</div></div>';
      }
      html += '</div>';
      html += '<div class="totrow"><span>' + t.total + '</span><b>' + money(S.order.total) + '</b></div>';
      html += '<div class="actions"><button class="btn main" data-act="again">' + t.again + '</button></div>';
      html += '<div class="note">' + t.note + '</div>';
    } else {
      html += '<h3>' + t.cart + '</h3>';
      if(!qty()){
        html += '<div class="empty" style="margin:26px 0 10px">' + t.emptyCart + '</div>';
      } else {
        for(var k in S.cart){
          var it2 = find(k); if(!it2 || !S.cart[k]) continue;
          html += '<div class="row"><div class="rn">' + it2.n[S.lang]
            + '<div class="rp">' + money(it2.p) + '</div></div>'
            + '<div class="stepper"><button data-act="dec" data-id="' + it2.id + '">−</button><span>' + S.cart[k] + '</span><button data-act="inc" data-id="' + it2.id + '">+</button></div></div>';
        }
        html += '<div class="totrow"><span>' + t.total + '</span><b>' + money(total()) + '</b></div>';
        html += '<div class="actions"><button class="btn ghost" data-act="clear">' + t.clear + '</button>'
          + '<button class="btn main" data-act="checkout">' + t.checkout + '</button></div>';
      }
    }
    s.innerHTML = html;
    s.className = 'sheet show';
    $('#backdrop').className = 'backdrop show';
  }

function render(){
    setTexts(); renderCats(); renderList(); renderBar(); renderSheet();
  }

var toastTimer = null;
  function toast(msg){
    var el = $('#toast');
    el.textContent = msg;
    el.className = 'toast show';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ el.className = 'toast'; }, 1500);
  }

function add(id, n){
    var cur = S.cart[id] || 0;
    var next = cur + n;
    if(next <= 0){ delete S.cart[id]; }
    else { S.cart[id] = next; }
    save();
    renderList(); renderBar();
    if(sheetOpen) renderSheet();
    if(n > 0){
      var it = find(id);
      toast(L().added + ' · ' + it.n[S.lang]);
    }
  }

function openSheet(){ sheetOpen = true; renderSheet(); }
  function closeSheet(){ sheetOpen = false; S.order = null; save(); renderSheet(); }

function checkout(){
    var items = [];
    for(var k in S.cart){
      if(S.cart[k] > 0) items.push({id:k, q:S.cart[k]});
    }
    if(!items.length) return;
    S.order = {
      no: 'A' + (1000 + Math.floor(Math.random()9000)),
      items: items,
      total: total()
    };
    S.cart = {};
    save();
    renderBar(); renderList(); renderSheet();
  }

document.addEventListener('click', function(e){
    var el = e.target.closest ? e.target.closest('[data-act]') : null;
    if(!el) return;
    var act = el.getAttribute('data-act');
    var id = el.getAttribute('data-id');

if(act === 'lang'){
      S.lang = el.getAttribute('data-lang') || 'zh';
      save(); render();
    } else if(act === 'cat'){
      S.cat = id; save(); renderCats(); renderList();
    } else if(act === 'add' || act === 'inc'){
      add(id, 1);
    } else if(act === 'dec'){
      add(id, -1);
    } else if(act === 'cart'){
      openSheet();
    } else if(act === 'close'){
      closeSheet();
    } else if(act === 'clear'){
      S.cart = {}; save(); renderList(); renderBar(); renderSheet();
    } else if(act === 'checkout'){
      checkout();
    } else if(act === 'again'){
      S.cart = {}; S.order = null; save();
      closeSheet(); renderList(); renderBar();
    }
  });

$('#q').addEventListener('input', function(e){
    S.q = e.target.value;
    save();
    renderList();
  });

load();
  $('#q').value = S.q;
  render();
})();
</script>
