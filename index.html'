    {id:'s4',cat:'snack',h:14,e:'🍘',p:15000,
      n:{zh:'香脆天贝',en:'Crispy Tempeh',id:'Tempe Goreng'},
      d:{zh:'本地豆饼，撒了点盐',en:'Local soy cake, lightly salted',id:'Tempe lokal, sedikit garam'}},
    {id:'d1',cat:'drink',h:190,e:'🍋',p:12000,
